{
  "grammar_version": 4,
  "policy_schema_version": 4,
  "compiled_abi_version": 4,
  "feature_registry_version": 1,
  "limits": {
    "max_nodes": 65534,
    "max_depth": 48,
    "normal_max_visits_per_tick": 4096,
    "max_blackboard_slots": 128,
    "max_state_slots": 512,
    "max_live_intents": 128,
    "max_parallel_children": 16
  },
  "blind_search_policy": {
    "whole_policy_mutation": false,
    "runtime_dag": false,
    "switch_i32": false,
    "state_hash_features": false,
    "identity_features": false,
    "future_state_features": false,
    "candidate_unit": "bounded_semantic_module"
  },
  "domains": {
    "market": {
      "features": ["STEP", "DAY", "HOUR", "OWN_MONEY", "OPP_MONEY", "MARKET_PRICE", "MARKET_INVENTORY", "OWN_SHED", "OWN_SHED_TOTAL", "OWN_INVENTORY", "SHOP_COUNT", "SHOP_AT", "SHOP_SEEN"],
      "actions": ["EmitMarketIntent"],
      "control": ["Sequence", "Selector", "ReactiveSequence", "ReactiveSelector", "If", "ReactiveIf", "SwitchEnum", "Invert", "ForceSuccess", "ForceFailure"]
    },
    "workforce": {
      "features": ["STEP", "HOUR", "OWN_UNITS", "OPP_UNITS", "OWN_HIRES_TODAY", "OPP_HIRES_TODAY", "OWN_WORKER_X", "OWN_WORKER_Y", "OWN_WORKER_TILE", "OWN_TILE_KIND", "OWN_TILE_ITEM"],
      "actions": ["EmitUnitIntent", "MoveUnitTo"],
      "control": ["Sequence", "Selector", "ReactiveSequence", "ReactiveSelector", "If", "ReactiveIf", "SwitchEnum", "TurnTimeout"]
    },
    "portfolio": {
      "features": ["STEP", "DAY", "HOUR", "OWN_MONEY", "OPP_MONEY", "OWN_LAND", "OPP_LAND", "OWN_SEED", "OWN_SHED", "MARKET_PRICE", "MARKET_INVENTORY", "SHOP_COUNT", "SHOP_AT", "SHOP_SEEN"],
      "actions": ["EmitMarketIntent", "SetBlackboard"],
      "control": ["Sequence", "Selector", "ReactiveSequence", "ReactiveSelector", "If", "ReactiveIf", "SwitchEnum"]
    }
  }
}
