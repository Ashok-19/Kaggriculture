{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recur-sion.local/bonsai-kg/policy-v3.schema.json",
  "title": "Bonsai-KG Policy v3",
  "description": "Structural authoring schema. python/bonsai_kg.py is the authoritative semantic/type/limit validator.",
  "type": "object",
  "required": ["schema_version", "tree"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 3},
    "name": {"type": "string"},
    "semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blackboard": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/blackboard_decl"}},
    "subtrees": {"type": "array", "items": {"$ref": "#/$defs/subtree_def"}},
    "tree": {"$ref": "#/$defs/node"}
  },
  "$defs": {
    "blackboard_decl": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "type": {"enum": ["BOOL", "I32", "U16", "ENUM8", "TILE", "UNIT", "ITEM"]},
        "initial": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    },
    "portable_type": {"enum": ["I32", "TILE", "UNIT", "ITEM"]},
    "binding_ref": {
      "type": "object",
      "required": ["binding"],
      "additionalProperties": false,
      "properties": {"binding": {"type": "string"}}
    },
    "feature_arg_ref": {
      "oneOf": [
        {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        {"type": "string"},
        {"type": "object", "required": ["const"], "additionalProperties": false,
         "properties": {"const": {"oneOf": [{"type": "integer"}, {"type": "string"}]}, "type": {"$ref": "#/$defs/portable_type"}}},
        {"type": "object", "required": ["blackboard"], "additionalProperties": false,
         "properties": {"blackboard": {"type": "string"}}},
        {"$ref": "#/$defs/binding_ref"}
      ]
    },
    "value_ref": {
      "oneOf": [
        {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        {"type": "object", "required": ["const"], "additionalProperties": false,
         "properties": {"const": {"oneOf": [{"type": "integer"}, {"type": "string"}]}, "type": {"$ref": "#/$defs/portable_type"}}},
        {"type": "object", "required": ["blackboard"], "additionalProperties": false,
         "properties": {"blackboard": {"type": "string"}}},
        {"type": "object", "required": ["feature"], "additionalProperties": false,
         "properties": {
           "feature": {"type": "string"},
           "arg": {"$ref": "#/$defs/feature_arg_ref"},
           "args": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/feature_arg_ref"}}
         }},
        {"$ref": "#/$defs/binding_ref"}
      ]
    },
    "item_value_ref": {
      "oneOf": [
        {"type": "string"},
        {"$ref": "#/$defs/value_ref"}
      ]
    },
    "slot_ref": {
      "oneOf": [
        {"type": "string"},
        {"$ref": "#/$defs/binding_ref"}
      ]
    },
    "predicate": {
      "type": "object", "required": ["lhs", "op", "rhs"], "additionalProperties": false,
      "properties": {"lhs": {"$ref": "#/$defs/value_ref"}, "op": {"enum": ["EQ", "NE", "LT", "LE", "GT", "GE"]}, "rhs": {"$ref": "#/$defs/value_ref"}}
    },
    "effect": {
      "type": "object", "required": ["op", "slot"], "additionalProperties": false,
      "properties": {"op": {"enum": ["set", "clear", "add"]}, "slot": {"$ref": "#/$defs/slot_ref"}, "value": {"$ref": "#/$defs/value_ref"}}
    },
    "effect_list": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/effect"}},
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "failure_if": {"$ref": "#/$defs/predicate"}, "success_if": {"$ref": "#/$defs/predicate"},
        "skip_if": {"$ref": "#/$defs/predicate"}, "while": {"$ref": "#/$defs/predicate"},
        "on_success": {"$ref": "#/$defs/effect_list"}, "on_failure": {"$ref": "#/$defs/effect_list"},
        "on_halted": {"$ref": "#/$defs/effect_list"}, "post": {"$ref": "#/$defs/effect_list"}
      }
    },
    "port_spec": {
      "oneOf": [
        {"$ref": "#/$defs/portable_type"},
        {"type": "object", "required": ["type"], "additionalProperties": false,
         "properties": {"type": {"$ref": "#/$defs/portable_type"}, "mode": {"enum": ["in", "out", "inout"]}}}
      ]
    },
    "subtree_def": {
      "type": "object", "required": ["name", "parameters", "tree"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/port_spec"}},
        "tree": {"$ref": "#/$defs/node"}
      }
    },
    "node": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["Sequence", "Selector", "ReactiveSequence", "ReactiveSelector", "If", "Parallel", "Invert", "ForceSuccess", "ForceFailure", "TurnTimeout", "Retry", "Repeat", "KeepRunningUntilFailure", "Success", "Failure", "Condition", "SetBlackboard", "AddBlackboard", "EmitUnitIntent", "EmitMarketIntent", "WaitTurns", "MoveUnitTo", "Subtree"]},
        "name": {"type": "string"}, "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "children": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/node"}},
        "child": {"$ref": "#/$defs/node"}, "condition": {"$ref": "#/$defs/node"}, "then": {"$ref": "#/$defs/node"}, "else": {"$ref": "#/$defs/node"},
        "lhs": {"$ref": "#/$defs/value_ref"}, "op": {"type": "string"}, "rhs": {"$ref": "#/$defs/value_ref"},
        "slot": {"$ref": "#/$defs/slot_ref"}, "value": {"$ref": "#/$defs/value_ref"},
        "n": {"type": "integer"}, "turns": {"type": "integer"}, "success_threshold": {"type": "integer"}, "failure_threshold": {"type": "integer"},
        "unit": {"$ref": "#/$defs/value_ref"}, "target": {"$ref": "#/$defs/value_ref"}, "x": {"type": "integer"}, "y": {"type": "integer"},
        "priority": {"type": "integer"}, "action": {"type": "string"}, "item": {"$ref": "#/$defs/item_value_ref"}, "quantity": {"$ref": "#/$defs/value_ref"},
        "subtree": {"type": "string"}, "bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value_ref"}}
      }
    }
  }
}
